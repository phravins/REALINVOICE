{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RealInvoice",
  "version": "0.2.0",
  "identifier": "in.osworks.realinvoice",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RealInvoice",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "OSWORKS",
    "copyright": "\u00a9 OSWORKS",
    "category": "Business",
    "shortDescription": "Offline-first GST invoicing for Indian SMEs",
    "longDescription": "RealInvoice Office Console \u2014 the billing counter's desktop application. Raise GST invoices, keep a local invoice history and reprint past bills, with everything stored on this machine so billing never stops when the internet does.",
    "licenseFile": "../../LICENSE",
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "compression": "lzma"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
